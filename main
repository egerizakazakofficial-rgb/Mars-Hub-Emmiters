createLabel("Gemini Key:", settingsInner, 0); local gemInput = Instance.new("TextBox"); gemInput.Size = UDim2.new(1,0,0,34); gemInput.Position = UDim2.new(0,0,0,24); gemInput.BackgroundColor3 = Color3.fromRGB(28,28,30); gemInput.Text = AISettings.geminiKey or ""; gemInput.Parent = settingsInner; Instance.new("UICorner", gemInput).CornerRadius = UDim.new(0,6)
