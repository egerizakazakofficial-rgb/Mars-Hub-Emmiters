-- connect quick and header AI buttons to toggle
local aiOpen = false
local function toggleAIUI()
    aiOpen = not aiOpen
    if aiOpen then
        detectKeysFromReplicatedStorage()
        aiMain.ZIndex = 1000
        aiTop.ZIndex = 1001
        chatScroll.ZIndex = 1001
        aiInputFrame.ZIndex = 1001
        settingsPanel.ZIndex = 1200
        aiMain.Visible = true
        aiMain:TweenPosition(UDim2.new(0.5,0,0.5,0), "Out", "Back", 0.35, true)
    else
        aiMain:TweenPosition(UDim2.new(0.5,0,1.5,0), "Out", "Back", 0.35, true)
        task.delay(0.36, function()
            if aiMain and aiMain.Parent then aiMain.Visible = false end
        end)
    end
end

quickAiBtn.MouseButton1Click:Connect(toggleAIUI)
aiBtn.MouseButton1Click:Connect(toggleAIUI)
aiSettingsBtn.MouseButton1Click:Connect(function() settingsPanel.Visible = not settingsPanel.Visible end)
aiClose.MouseButton1Click:Connect(toggleAIUI)
aiSizeBtn.MouseButton1Click:Connect(function()
    local cur = settings.aiSize or "max"
    if cur == "small" then setAISize("normal")
    elseif cur == "normal" then setAISize("max")
    else setAISize("small") end
    saveSettings()
end)

