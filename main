-- helper to set ai size modes
local function setAISize(mode)
    mode = mode or "max"
    settings.aiSize = mode
    if mode == "small" then
        aiMain.Size = UDim2.new(0.6, 0, 0.5, 0)
        aiSizeConst.MaxSize = Vector2.new(700,420)
        aiSizeConst.MinSize = Vector2.new(380,200)
    elseif mode == "normal" then
        aiMain.Size = UDim2.new(0.8, 0, 0.7, 0)
        aiSizeConst.MaxSize = Vector2.new(1000,700)
        aiSizeConst.MinSize = Vector2.new(420,220)
    else -- max
        aiMain.Size = UDim2.new(0.97, 0, 0.92, 0)
        aiSizeConst.MaxSize = Vector2.new(1400,1000)
        aiSizeConst.MinSize = Vector2.new(700,400)
    end
end
setAISize(settings.aiSize)

