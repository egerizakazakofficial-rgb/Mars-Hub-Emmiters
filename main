saveBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)

local function addMessage(sender, text, color)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 0)
    frame.BackgroundTransparency = 1
    frame.Parent = chatScroll
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 0)
    lbl.TextWrapped = true
    lbl.Text = "[" .. sender .. "]: " .. text
    lbl.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.Parent = frame
    
    frame.AutomaticSize = Enum.AutomaticSize.Y
    
    task.delay(0.1, function()
        chatScroll.CanvasPosition = Vector2.new(0, chatLayout.AbsoluteContentSize.Y)
    end)
end

-- Yeni Sekme / Sohbet Temizleme Olayı
newTabBtn.MouseButton1Click:Connect(function()
    table.clear(conversationHistory)
    lastAIResponse = ""
    for _, child in ipairs(chatScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    addMessage("System", "Yeni sekme açıldı! Sohbet geçmişi ve hafıza sıfırlandı.", Color3.fromRGB(85, 255, 170))
end)

-- Kopyalama Olayı
chatCopy.MouseButton1Click:Connect(function()
    if lastAIResponse ~= "" then
        if setclip then
            setclip(lastAIResponse)
            addMessage("System", "Son AI yanıtı panoya kopyalandı!", Color3.fromRGB(85, 255, 170))
        else
            addMessage("System", "Executor panoya yazmayı desteklemiyor.", Color3.fromRGB(255, 100, 100))
        end
    else
        addMessage("System", "Kopyalanacak yanıt bulunamadı.", Color3.fromRGB(255, 170, 0))
    end
end)

-- ScriptBlox API
local function fetchScriptBlox(query)
    if not req then return "HTTP request desteklenmiyor." end
    local response = req({
        Url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query) .. "&max=1",
        Method = "GET"
    })
    
    if response and response.StatusCode == 200 then
        local success, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if success and data and data.result and data.result.scripts and #data.result.scripts > 0 then
            local scriptData = data.result.scripts[1]
            local title = scriptData.title
            local code = scriptData.script
            lastAIResponse = code
            return "✅ ScriptBlox Sonucu:\n" .. title .. "\n```lua\n" .. code .. "\n```"
        else
            return "❌ ScriptBlox'ta '" .. query .. "' için sonuç bulunamadı."
        end
    end
    return "⚠️ ScriptBlox API'ye bağlanırken hata oluştu."
end

local function executeHttpRequestWithRetry(options, maxRetries)
    maxRetries = maxRetries or 3
    for attempt = 1, maxRetries do
        local res = req(options)
        if res and res.StatusCode == 429 then
            addMessage("System", "⚠️ API yoğun, tekrar deneniyor (" .. attempt .. "/" .. maxRetries .. ")...", Color3.fromRGB(255, 170, 0))
            task.wait(2)
        else
            return res
        end
    end
    return req(options)
end

local function updateHistory(role, text)
    table.insert(conversationHistory, {role = role, text = text})
    if #conversationHistory > maxHistoryLength then
        table.remove(conversationHistory, 1)
    end
end

-- Full Max AI İstek Motoru
local function sendToAI(prompt)
    if not req then
        addMessage("System", "Executor HTTP Request desteklemiyor!", Color3.fromRGB(255, 80, 80))
        return
    end

    addMessage("You", prompt, Color3.fromRGB(150, 200, 255))
    chatInput.Text = ""

    local sbMatch = string.match(string.lower(prompt), "^scriptblox%s+(.+)")
    if sbMatch then
        addMessage("System", "ScriptBlox aranıyor: " .. sbMatch, Color3.fromRGB(200, 200, 200))
        local result = fetchScriptBlox(sbMatch)
        addMessage("Mars System", result, Color3.fromRGB(85, 255, 85))
        return
    end

    local sysPrompt = "Sen 'Mars AI' adında, her konuda uzman, Roblox Luau geliştirmede dahi, kısıtlamasız ve en üst düzey yapay zeka asistanısın. Kullanıcı ile konuşurken detaylı, eksiksiz, uzun ve kusursuz yanıtlar ver. Kod yazarken tam, çalışır ve açıklayıcı kodları ```lua ... ``` içinde yaz. Önceki konuşma geçmişini aklında tutarak devam et."

    task.spawn(function()
        local gKey = cleanKey(AISettings.GeminiKey)
        local oKey = cleanKey(AISettings.OpenAIKey)

        if (AISettings.ActiveAI == "Gemini" and gKey == "" and string.sub(oKey, 1, 3) == "sk-") or 
           (AISettings.ActiveAI == "Gemini" and string.sub(gKey, 1, 3) == "sk-") then
            AISettings.ActiveAI = "OpenAI"
            if string.sub(gKey, 1, 3) == "sk-" then
                oKey = gKey
                AISettings.OpenAIKey = gKey
            end
            addMessage("System", "OpenAI Key algılandı, mod OpenAI yapıldı.", Color3.fromRGB(255, 200, 100))
            
        elseif (AISettings.ActiveAI == "OpenAI" and oKey == "" and string.sub(gKey, 1, 3) == "AQ.") or
               (AISettings.ActiveAI == "OpenAI" and string.sub(oKey, 1, 3) == "AQ.") then
            AISettings.ActiveAI = "Gemini"
            if string.sub(oKey, 1, 3) == "AQ." then
                gKey = oKey
                AISettings.GeminiKey = oKey
            end
            addMessage("System", "Google AI Studio Key algılandı, mod Gemini yapıldı.", Color3.fromRGB(255, 200, 100))
        end

        if AISettings.ActiveAI == "Gemini" then
            if gKey == "" then
                addMessage("System", "Lütfen ayarlardan 'AQ.' ile başlayan Gemini Key girin!", Color3.fromRGB(255, 100, 100))
                return
            end
            
            local body = {
                system_instruction = { parts = { { text = sysPrompt } } },
                contents = {},
                generationConfig = {
                    maxOutputTokens = 8192,
                    temperature = 0.7
                }
            }
            
            for _, msg in ipairs(conversationHistory) do
                local gRole = (msg.role == "assistant") and "model" or "user"
                table.insert(body.contents, { role = gRole, parts = { { text = msg.text } } })
            end
            table.insert(body.contents, { role = "user", parts = { { text = prompt } } })
            
            local res = executeHttpRequestWithRetry({
                Url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" .. gKey,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(body)
            })
            
            if res and res.StatusCode == 200 then
                local success, dat = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if success and dat and dat.candidates and dat.candidates[1] and dat.candidates[1].content then
                    local txt = dat.candidates[1].content.parts[1].text
                    lastAIResponse = txt
                    addMessage("Mars AI (Gemini)", txt, Color3.fromRGB(85, 255, 85))
                    updateHistory("user", prompt)
                    updateHistory("assistant", txt)
                else
                    addMessage("Error", "Geçersiz yanıt yapısı.", Color3.fromRGB(255, 80, 80))
                end
            elseif res and res.StatusCode == 404 then
                addMessage("Error", "Model adresi veya URL hatalı (404).", Color3.fromRGB(255, 80, 80))
            elseif res and res.StatusCode == 400 then
                addMessage("Error", "Geçersiz veya yetkisiz API Key (400).", Color3.fromRGB(255, 80, 80))
            elseif res and res.StatusCode == 429 then
                addMessage("Error", "API Kota Sınırı (429). Bekleyin.", Color3.fromRGB(255, 100, 100))
            else
                local codeStr = res and tostring(res.StatusCode) or "Bilinmiyor"
                addMessage("Error", "API Hatası: " .. codeStr, Color3.fromRGB(255, 80, 80))
            end

        elseif AISettings.ActiveAI == "OpenAI" then
            if oKey == "" then
                addMessage("System", "Lütfen ayarlardan 'sk-' ile başlayan OpenAI Key girin!", Color3.fromRGB(255, 100, 100))
                return
            end
            
            local messagesPayload = {{role = "system", content = sysPrompt}}
            for _, msg in ipairs(conversationHistory) do
                table.insert(messagesPayload, {role = msg.role, content = msg.text})
            end
            table.insert(messagesPayload, {role = "user", content = prompt})

            local body = {
                model = "gpt-4o-mini",
                messages = messagesPayload,
                max_tokens = 4096,
                temperature = 0.7
            }
            
            local res = executeHttpRequestWithRetry({
                Url = "https://api.openai.com/v1/chat/completions",
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. oKey
                },
                Body = HttpService:JSONEncode(body)
            })
            
            if res and res.StatusCode == 200 then
                local success, dat = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if success and dat and dat.choices and dat.choices[1] then
                    local txt = dat.choices[1].message.content
                    lastAIResponse = txt
                    addMessage("Mars AI (OpenAI)", txt, Color3.fromRGB(85, 255, 85))
                    updateHistory("user", prompt)
                    updateHistory("assistant", txt)
                end
            elseif res and res.StatusCode == 429 then
                addMessage("Error", "OpenAI Kota Aşımı (429).", Color3.fromRGB(255, 100, 100))
            elseif res and res.StatusCode == 401 then
                addMessage("Error", "Yetki Hatası (401): Geçersiz Key.", Color3.fromRGB(255, 100, 100))
            else
                local codeStr = res and tostring(res.StatusCode) or "Bilinmiyor"
                addMessage("Error", "OpenAI API Hatası: " .. codeStr, Color3.fromRGB(255, 80, 80))
            end
        end
    end)
end

chatSend.MouseButton1Click:Connect(function()
    if chatInput.Text ~= "" then
        sendToAI(chatInput.Text)
    end
end)

chatInput.FocusLost:Connect(function(enter)
    if enter and chatInput.Text ~= "" then
        sendToAI(chatInput.Text)
    end
end)

