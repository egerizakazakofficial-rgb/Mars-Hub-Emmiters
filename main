-- Memory Leak Korumalı Animasyon Döngüsü
task.spawn(function()
    local counter = 0
    while task.wait(0.03) do
        if not openBtn or not openBtn.Parent then break end 
        counter = counter + 0.01
        local rainbowColor1 = Color3.fromHSV(math.abs(math.sin(counter)), 1, 1)
        local purpleVibe = Color3.fromRGB(130, 0, 255)
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, rainbowColor1),
            ColorSequenceKeypoint.new(1, purpleVibe)
        })
        openStroke.Color = purpleVibe:Lerp(rainbowColor1, 0.5)
    end
end)

makeSmoothDrag(openBtn)

