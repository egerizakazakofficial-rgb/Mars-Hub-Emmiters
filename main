-- displayMessage now returns the bubble objects so we can update them (typing -> final)
local function displayMessage(text, isUser)
    local msgContainer = Instance.new("Frame")
    msgContainer.Size = UDim2.new(1, 0, 0, 0)
    msgContainer.BackgroundTransparency = 1
    msgContainer.Parent = chatScroll
    msgContainer.ZIndex = 101

    local msgBubble = Instance.new("TextLabel")
    msgBubble.Size = UDim2.new(0.85, 0, 0, 0)
    msgBubble.Position = isUser and UDim2.new(0.15, 0, 0, 0) or UDim2.new(0, 0, 0, 0)
    msgBubble.BackgroundColor3 = isUser and settings.uiAccentColor or Color3.fromRGB(30, 30, 35)
    msgBubble.TextColor3 = isUser and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
    msgBubble.TextWrapped = true
    msgBubble.Font = Enum.Font.Gotham
    msgBubble.TextSize = 12
    msgBubble.Text = text or ""
    msgBubble.Parent = msgContainer
    msgBubble.ZIndex = 101

    Instance.new("UICorner", msgBubble).CornerRadius = UDim.new(0, 8)
    local padding = Instance.new("UIPadding", msgBubble)
    padding.Padding = UDim.new(0, 12, 0, 12)

    -- Auto-size using current aiMain size to compute width
    local function resizeBubble()
        local computedWidth = math.max(200, math.floor(aiMain.AbsoluteSize.X * 0.85) - 24)
        local textSize = TextService:GetTextSize(msgBubble.Text, msgBubble.TextSize, msgBubble.Font, Vector2.new(computedWidth, 2000))
        msgBubble.Size = UDim2.new(0.85, 0, 0, math.max(textSize.Y + 24, 30))
        msgContainer.Size = UDim2.new(1, 0, 0, msgBubble.Size.Y.Offset + 5)
    end

    -- Wait a frame then resize (aiMain might not be fully sized yet)
    task.spawn(function()
        task.wait() -- allow layout to compute
        if msgBubble and msgBubble.Parent then
            resizeBubble()
        end
    end)

    -- Return bubble so caller can update text
    return msgBubble, msgContainer, resizeBubble
end

-- AI request helper with timeout and unified callback
local function requestAI(userMessage, timeoutSeconds, callback)
    timeoutSeconds = timeoutSeconds or 25
    local done = false

    -- safety wrapper to ensure callback called once
    local function finish(success, text)
        if done then return end
        done = true
        pcall(function() callback(success, text) end)
    end

    task.spawn(function()
        if settings.apiProvider == "gemini" then
            if settings.geminiKey == "" then
                finish(false, "❌ Gemini API Key is not set. Please go to Settings.")
                return
            end

            local modelName = settings.geminiModel == "flash" and "gemini-2.0-flash-exp" or "gemini-1.5-lite"
            local url = "https://generativelanguage.googleapis.com/v1beta/models/" .. modelName .. ":generateContent?key=" .. settings.geminiKey
            local ok, response = pcall(function()
                local payload = {
                    contents = {
                        {
                            parts = {
                                { text = userMessage }
                            }
                        }
                    }
                }
                -- Use PostAsync; some environments may restrict RequestAsync
                return HttpService:PostAsync(url, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
            end)
            if not ok or not response then
                finish(false, "❌ Failed to contact Gemini API.")
                return
            end

            local ok2, data = pcall(function() return HttpService:JSONDecode(response) end)
            if not ok2 or not data then
                finish(false, "❌ Invalid response from Gemini API.")
                return
            end

            if data and data.candidates and data.candidates[1] and data.candidates[1].content and data.candidates[1].content.parts and data.candidates[1].content.parts[1] then
                finish(true, data.candidates[1].content.parts[1].text)
            else
                finish(false, "❌ No response from Gemini API.")
            end
        else -- openai
            if settings.openaiKey == "" then
                finish(false, "❌ OpenAI API Key is not set. Please go to Settings.")
                return
            end

            local url = "https://api.openai.com/v1/chat/completions"
            local ok, responseBody = pcall(function()
                local payload = {
                    model = settings.openaiModel,
                    messages = {
                        { role = "user", content = userMessage }
                    },
                    max_tokens = 2000,
                }

                -- Prefer RequestAsync if available for headers
                if HttpService.RequestAsync then
                    local req = HttpService:RequestAsync({
                        Url = url,
                        Method = "POST",
                        Headers = {
                            ["Content-Type"] = "application/json",
                            ["Authorization"] = "Bearer " .. settings.openaiKey
                        },
                        Body = HttpService:JSONEncode(payload)
                    })
                    return req and req.Body or nil
                else
                    return HttpService:PostAsync(url, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
                end
            end)

            if not ok or not responseBody then
                finish(false, "❌ Failed to contact OpenAI API.")
                return
            end

            local ok2, data = pcall(function() return HttpService:JSONDecode(responseBody) end)
            if not ok2 or not data then
                finish(false, "❌ Invalid response from OpenAI API.")
                return
            end

            if data and data.choices and data.choices[1] and data.choices[1].message and data.choices[1].message.content then
                finish(true, data.choices[1].message.content)
            else
                finish(false, "❌ No response from OpenAI API.")
            end
        end
    end)

    -- timeout routine
    task.delay(timeoutSeconds, function()
        if not done then
            done = true
            pcall(function() callback(false, "❌ Request timed out after " .. tostring(timeoutSeconds) .. "s.") end)
        end
    end)
end

