local settingsCloseBtn = Instance.new("TextButton"); settingsCloseBtn.Size = UDim2.new(0,36,0,36); settingsCloseBtn.Position = UDim2.new(1,-12,0,12); settingsCloseBtn.Text = "×"; settingsCloseBtn.BackgroundTransparency = 1; settingsCloseBtn.Parent = settingsPanel
