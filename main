-- Mesaj Ekleme
local function addChatMessage(sender, text, isError)
    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(1, 0, 0, 0)
    msgFrame.BackgroundTransparency = 1
    msgFrame.Parent = chatArea

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.Text = "**" .. sender .. "**: " .. text
    lbl.TextColor3 = isError and Color3.fromRGB(255, 80, 80) or (sender == "Sen" and Color3.fromRGB(200, 200, 255) or Color3.fromRGB(255, 255, 255))
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.Parent = msgFrame

    lbl.Size = UDim2.new(1, -10, 0, lbl.TextBounds.Y + 10)
    msgFrame.Size = UDim2.new(1, 0, 0, lbl.TextBounds.Y + 10)
    chatArea.CanvasSize = UDim2.new(0, 0, 0, chatLayout.AbsoluteContentSize.Y + 10)
    chatArea.CanvasPosition = Vector2.new(0, 9999)
end

-- Yapay Zeka API İstekleri
local function sendToAI(userText)
    addChatMessage("Sen", userText)
    chatInput.Text = ""
    addChatMessage("Sistem", config.activeApi .. " düşünülüyor...", false)
    
    task.spawn(function()
        if not requestFunc then
            addChatMessage("Hata", "Executor HTTP desteklemiyor!", true)
            return
        end

        local responseText = "Bir hata oluştu."
        if config.activeApi == "Gemini" then
            if config.apiKeyGemini == "" then addChatMessage("Hata", "Gemini API Key eksik! Ayarlardan girin.", true) return end
            local url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" .. config.apiKeyGemini
            local payload = { contents = { { parts = { { text = userText } } } } }
            local res = requestFunc({
                Url = url,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data.candidates and data.candidates[1] then
                    responseText = data.candidates[1].content.parts[1].text
                else
                    responseText = "API Hatası: " .. tostring(res.Body)
                end
            end

        elseif config.activeApi == "OpenAI" then
            if config.apiKeyOpenAI == "" then addChatMessage("Hata", "OpenAI API Key eksik! Ayarlardan girin.", true) return end
            local url = "https://api.openai.com/v1/chat/completions"
            local payload = {
                model = "gpt-3.5-turbo",
                messages = { { role = "user", content = userText } }
            }
            local res = requestFunc({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. config.apiKeyOpenAI
                },
                Body = HttpService:JSONEncode(payload)
            })
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data.choices and data.choices[1] then
                    responseText = data.choices[1].message.content
                else
                    responseText = "API Hatası: " .. tostring(res.Body)
                end
            end
        end

        addChatMessage(config.activeApi, responseText)
    end)
end

sendBtn.MouseButton1Click:Connect(function()
    if chatInput.Text ~= "" then sendToAI(chatInput.Text) end
end)
chatInput.FocusLost:Connect(function(enter)
    if enter and chatInput.Text ~= "" then sendToAI(chatInput.Text) end
end)

-- UI Animasyonları & Butonlar
local aiOpen = false
aiBtn.MouseButton1Click:Connect(function()
    aiOpen = not aiOpen
    aiPanel.Visible = aiOpen
end)

aiClose.MouseButton1Click:Connect(function()
    aiOpen = false
    aiPanel.Visible = false
end)

local aiMinimized = false
aiMin.MouseButton1Click:Connect(function()
    aiMinimized = not aiMinimized
    if aiMinimized then
        aiPanel:TweenSize(UDim2.new(0, 450, 0, 40), "Out", "Quad", 0.3, true)
    else
        aiPanel:TweenSize(UDim2.new(0, 450, 0, 350), "Out", "Quad", 0.3, true)
    end
end)

local settingsOpen = false
aiSettingsBtn.MouseButton1Click:Connect(function()
    settingsOpen = not settingsOpen
    settingsPanel.Visible = settingsOpen
    chatArea.Visible = not settingsOpen
    inputFrame.Visible = not settingsOpen
end)

local open = false
local function toggleUI()
    open = not open
    main:TweenPosition(open and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, 0, 1.5, 0), "Out", "Back", 0.5, true)
end

openBtn.MouseButton1Click:Connect(toggleUI)
close.MouseButton1Click:Connect(toggleUI)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.M then toggleUI() end
end)

-- Tema & RGB Döngüsü
local counter = 0
RunService.RenderStepped:Connect(function(dt)
    counter = counter + (dt * 0.5)
    
    local c1, c2
    if config.theme.rgb then
        c1 = Color3.fromHSV(math.abs(math.sin(counter)), 1, 1)
        c2 = Color3.fromHSV(math.abs(math.cos(counter)), 1, 1)
    else
        c1 = config.theme.color
        c2 = config.theme.color
    end

    local gradientColor
    if config.theme.gradient then
        gradientColor = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c1),
            ColorSequenceKeypoint.new(1, c2)
        })
    else
        gradientColor = ColorSequence.new(c1)
    end

    for _, elem in ipairs(themeElements) do
        if elem.grad then
            elem.grad.Color = gradientColor
        end
        if not config.theme.gradient and elem.stroke then
            elem.stroke.Color = c1
        end
    end
end)
