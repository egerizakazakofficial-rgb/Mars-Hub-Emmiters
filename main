Instance.new("UICorner", saveKeysBtn).CornerRadius = UDim.new(0,6)

saveKeysBtn.MouseButton1Click:Connect(function()
    settings.geminiKey = trim(gemInput.Text)
    settings.openaiKey = trim(openInput.Text)
    saveSettings()
    displayMessage("✅ API keys saved to settings.", false)
end)

settingsClose.MouseButton1Click:Connect(function() settingsPanel.Visible = false end)

-- Detect keys from ReplicatedStorage folder "MarsHubAIKeys" (StringValues: "GeminiKey" and "OpenAIKey")
local function detectKeysFromReplicatedStorage()
    local ok, folder = pcall(function() return ReplicatedStorage:FindFirstChild("MarsHubAIKeys") end)
    if ok and folder and folder:IsA("Folder") then
        local g = folder:FindFirstChild("GeminiKey")
        local o = folder:FindFirstChild("OpenAIKey")
        if g and g:IsA("StringValue") and trim(g.Value) ~= "" then
            settings.geminiKey = trim(g.Value)
        end
        if o and o:IsA("StringValue") and trim(o.Value) ~= "" then
            settings.openaiKey = trim(o.Value)
        end
        -- save detected keys to DataStore for persistence (best-effort)
        saveSettings()
    end
end

-- call detection periodically and also on toggle
task.spawn(function()
    while true do
        pcall(detectKeysFromReplicatedStorage)
        task.wait(10) -- every 10s check
    end
end)

-- AI open/close logic — ensure visible, centered, high ZIndex
local aiOpen = false
local function toggleAIUI()
    aiOpen = not aiOpen
    if aiOpen then
        -- try to detect keys from ReplicatedStorage right before opening
        pcall(detectKeysFromReplicatedStorage)

        -- set ZIndex high so it's on top
        aiMain.ZIndex = 1000
        aiTop.ZIndex = 1001
        chatScroll.ZIndex = 1001
        aiInputFrame.ZIndex = 1001
        settingsPanel.ZIndex = 1200

        aiMain.Visible = true
        -- center on screen
        aiMain:TweenPosition(UDim2.new(0.5,0,0.5,0), "Out", "Back", 0.35, true)
    else
        aiMain:TweenPosition(UDim2.new(0.5,0,1.5,0), "Out", "Back", 0.35, true)
        task.delay(0.36, function()
            if aiMain and aiMain.Parent then
                aiMain.Visible = false
            end
        end)
    end
end

-- connect both the AI button inside emitter header (if present) and quick button
-- (if emitter header aiBtn exists in your emitter UI, it should call the same toggle)
if quickAiBtn then quickAiBtn.MouseButton1Click:Connect(toggleAIUI) end

-- ALSO: if your emitter header's aiBtn exists (in original code), connect it:
-- try to find it (defensive)
pcall(function()
    local emitterHeaderAI = emitterMain:FindFirstChild("AIButton") -- if you named it AIButton
    if emitterHeaderAI and emitterHeaderAI:IsA("TextButton") then
        emitterHeaderAI.MouseButton1Click:Connect(toggleAIUI)
    end
end)

-- connect the quick launcher and openBtn for emitter UI toggling (if you still want)
-- (openBtn toggles emitter UI in original script; keep that behavior)
-- you probably already have emitter toggle; ensure openBtn still toggles emitter.

-- size quick-cycle button on aiTop
aiSizeBtn.MouseButton1Click:Connect(function()
    local current = settings.aiSize or "max"
    if current == "small" then setAISize("normal")
    elseif current == "normal" then setAISize("max")
    else setAISize("small") end
    saveSettings()
end)

-- settings btn
aiSettingsBtn.MouseButton1Click:Connect(function() settingsPanel.Visible = not settingsPanel.Visible end)
aiClose.MouseButton1Click:Connect(toggleAIUI)

-- auto-scroll chat whenever content changes
chatLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    chatScroll.CanvasSize = UDim2.new(0,0,0, chatLayout.AbsoluteContentSize.Y + 20)
    chatScroll.CanvasPosition = Vector2.new(0, chatLayout.AbsoluteContentSize.Y)
end)

-- welcome message
displayMessage("👋 Welcome to Mars Hub AI Chat! Open Settings to set API keys or place them in ReplicatedStorage/MarsHubAIKeys.", false)

-- ensure initial canvases sized
task.defer(function()
    pcall(function()
        scroll.CanvasSize = UDim2.new(0,0,0, listLayout.AbsoluteContentSize.Y + 40)
        chatScroll.CanvasSize = UDim2.new(0,0,0, chatLayout.AbsoluteContentSize.Y + 20)
    end)
end)

