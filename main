local function addMessage(sender, text, color)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 0)
    frame.BackgroundTransparency = 1
    frame.Parent = chatScroll
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 0)
    lbl.TextWrapped = true
    lbl.Text = "[" .. sender .. "]: " .. text
    lbl.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.Parent = frame
    
    frame.AutomaticSize = Enum.AutomaticSize.Y
    
    task.delay(0.1, function()
        chatScroll.CanvasPosition = Vector2.new(0, chatLayout.AbsoluteContentSize.Y)
    end)
end

-- ScriptBlox API Entegrasyonu
local function fetchScriptBlox(query)
    if not req then return "HTTP request desteklenmiyor." end
    local response = req({
        Url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query) .. "&max=1",
        Method = "GET"
    })
    
    if response and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.result and data.result.scripts and #data.result.scripts > 0 then
            local scriptData = data.result.scripts[1]
            local title = scriptData.title
            local code = scriptData.script
            return "✅ ScriptBlox Sonucu:\n" .. title .. "\n```lua\n" .. code .. "\n```"
        else
            return "❌ ScriptBlox'ta '" .. query .. "' için sonuç bulunamadı."
        end
    end
    return "⚠️ ScriptBlox API'ye bağlanırken hata oluştu."
end

-- 429 Retry Fonksiyonu
local function executeHttpRequestWithRetry(options, maxRetries)
    maxRetries = maxRetries or 3
    for attempt = 1, maxRetries do
        local ok, res = pcall(function() return req(options) end)
        if not ok or not res then
            -- network/exec hata; küçük bekleme ile yeniden dene
            task.wait(1)
        else
            if res.StatusCode == 429 then
                addMessage("System", "⚠️ API yoğun, 3 sn beklenip tekrar deneniyor (" .. attempt .. "/" .. maxRetries .. ")...", Color3.fromRGB(255, 170, 0))
                task.wait(3)
            else
                return res
            end
        end
    end
    -- son bir deneme
    local ok, res = pcall(function() return req(options) end)
    if ok then return res end
    return nil
end

-- AI İstek Yollama Modülü (Gerçek Sohbet Motoru, Hata Çözücü & AQ. Eşleme)
local function detectAndApplyKeysFromText(text)
    text = tostring(text or "")
    local t = cleanKey(text)
    if string.sub(t,1,3) == "AQ." then
        AISettings.GeminiKey = t
        AISettings.ActiveAI = "Gemini"
        addMessage("System", "Metinde AQ. ile başlayan anahtar algılandı, Gemini aktif edildi.", Color3.fromRGB(255,200,100))
        return true
    elseif string.sub(t,1,3) == "sk-" then
        AISettings.OpenAIKey = t
        AISettings.ActiveAI = "OpenAI"
        addMessage("System", "Metinde sk- ile başlayan anahtar algılandı, OpenAI aktif edildi.", Color3.fromRGB(255,200,100))
        return true
    end
    return false
end

local function detectSpecialTriggers(prompt)
    local p = string.lower(tostring(prompt or ""))
    -- Eğer kullanıcı 'max full' yazdıysa full modu aktif et
    if string.match(p, "^max%s*full") then
        IncludeConversation = true
        fullModeBtn.Text = "Full Chat Mode: " .. tostring(IncludeConversation)
        addMessage("System", "Full Chat Mode aktif edildi (tüm geçmiş gönderilecek).", Color3.fromRGB(200,200,255))
        return true
    end
    -- 'max off' ile kapatılabilir
    if string.match(p, "^max%s*off") then
        IncludeConversation = false
        fullModeBtn.Text = "Full Chat Mode: " .. tostring(IncludeConversation)
        addMessage("System", "Full Chat Mode kapatıldı (sadece son mesaj gönderilecek).", Color3.fromRGB(200,200,255))
        return true
    end
    -- Eğer kullanıcı doğrudan bir anahtar yapıştırdıysa da algıla
    if TriggerDetect and detectAndApplyKeysFromText(prompt) then
        return true
    end
    return false
end

local function sendToAI(prompt)
    if not req then
        addMessage("System", "Executor HTTP Request desteklemiyor!", Color3.fromRGB(255, 80, 80))
        return
    end

    -- Temizleme & otomatik algılama
    AISettings.GeminiKey = cleanKey(geminiBox.Text or AISettings.GeminiKey)
    AISettings.OpenAIKey = cleanKey(openaiBox.Text or AISettings.OpenAIKey)

    -- Trigger algılama (ör: 'max full' veya anahtar yapıştırma)
    if TriggerDetect then
        local trig = detectSpecialTriggers(prompt)
        if trig then
            -- Eğer trigger sadece modu değiştirdiyse sohbet devam edebilir; ama eğer anahtar algılandı ve bu mesaj anahtar ise istemeyebilirsiniz
            -- Burada trigger tespit edildiyse mesajı kullanıcının yanlışlıkla anahtar olarak göndermesini engellemek için sohbeti sonlandırıyoruz
            -- (kullanıcı yine ayrı bir mesajla sohbeti sürdürebilir)
            return
        end
    end

    addMessage("You", prompt, Color3.fromRGB(150, 200, 255))
    chatInput.Text = ""

    -- Scriptblox araması sadece mesaj "scriptblox " ile başlıyorsa çalışacak.
    local sbMatch = string.match(string.lower(prompt), "^scriptblox%s+(.+)")
    if sbMatch then
        addMessage("System", "ScriptBlox üzerinde aranıyor: " .. sbMatch, Color3.fromRGB(200, 200, 200))
        local result = fetchScriptBlox(sbMatch)
        addMessage("Mars System", result, Color3.fromRGB(85, 255, 85))
        return
    end

    -- conversation'a kullanıcı mesajını ekle (çoklu tur)
    table.insert(conversation, {role = "user", content = prompt})

    task.spawn(function()
        local gKey = cleanKey(AISettings.GeminiKey)
        local oKey = cleanKey(AISettings.OpenAIKey)

        -- Eğer her iki anahtar boşsa kullanıcıyı uyar
        if (AISettings.ActiveAI == "Gemini" or (gKey ~= "" and string.sub(gKey,1,3) == "AQ.")) and (gKey == "") then
            if oKey ~= "" and string.sub(oKey,1,3) == "sk-" then
                AISettings.ActiveAI = "OpenAI"
                addMessage("System", "OpenAI anahtarı bulundu (sk-). OpenAI moduna geçiliyor.", Color3.fromRGB(255,200,100))
            else
                addMessage("System", "Hey, sohbete başlamak için ayarlardan Google AI Studio Key'ini (AQ. ile başlayan) girmen gerekiyor! API yokken Gemini çalışamaz :)", Color3.fromRGB(255, 150, 100))
                return
            end
        end

        if (AISettings.ActiveAI == "OpenAI" or (oKey ~= "" and string.sub(oKey,1,3) == "sk-")) and (oKey == "") then
            if gKey ~= "" and string.sub(gKey,1,3) == "AQ." then
                AISettings.ActiveAI = "Gemini"
                addMessage("System", "Google AI Studio anahtarı bulundu (AQ.). Gemini moduna geçiliyor.", Color3.fromRGB(255,200,100))
            else
                addMessage("System", "Sohbet için ayarlardan OpenAI Key'ini (sk- ile başlayan) girmen gerekiyor!", Color3.fromRGB(255, 100, 100))
                return
            end
        end

        if AISettings.ActiveAI == "Gemini" then
            gKey = cleanKey(AISettings.GeminiKey)
            if gKey == "" or string.sub(gKey,1,3) ~= "AQ." then
                addMessage("System", "Girdiğin API key 'AQ.' ile başlamıyor veya eksik. Google AI Studio üzerinden doğru aldığını kontrol et.", Color3.fromRGB(255, 150, 100))
                return
            end

            -- Gemini için fullPrompt oluşturma (IncludeConversation'e göre değişir)
            local fullPrompt = sysPrompt .. "\n\n"
            if IncludeConversation then
                for _, m in ipairs(conversation) do
                    if m.role == "user" then
                        fullPrompt = fullPrompt .. "User: " .. m.content .. "\n"
                    else
                        fullPrompt = fullPrompt .. "Assistant: " .. m.content .. "\n"
                    end
                end
            else
                -- sadece son user mesaj
                fullPrompt = fullPrompt .. "User: " .. prompt .. "\n"
            end

            local body = {
                contents = {{ parts = {{ text = fullPrompt }} }}
            }

            local res = executeHttpRequestWithRetry({
                Url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" .. gKey,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(body)
            }, 3)

            if res and res.StatusCode == 200 then
                local ok, dat = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok and dat and dat.candidates and dat.candidates[1] and dat.candidates[1].content then
                    local txt = dat.candidates[1].content.parts[1].text or ""
                    table.insert(conversation, {role = "assistant", content = txt})
                    addMessage("Mars AI (Gemini)", txt, Color3.fromRGB(85, 255, 85))
                else
                    addMessage("Error", "Cevap geldi ama okunabilir formatta değil.", Color3.fromRGB(255, 80, 80))
                end
            elseif res and res.StatusCode == 404 then
                addMessage("Error", "Bağlantı Hatası (404): Model veya API URL adresi hatalı. Google AI Studio projenizle ilgili bir sorun olabilir.", Color3.fromRGB(255, 80, 80))
            elseif res and res.StatusCode == 400 then
                addMessage("Error", "Format Hatası (400): Girilen API Key yetkisiz, silinmiş veya hatalı kopyalanmış olabilir.", Color3.fromRGB(255, 80, 80))
            elseif res and res.StatusCode == 429 then
                addMessage("Error", "Hız Sınırı (429): Google AI Studio sınırına ulaştın, biraz bekle dostum.", Color3.fromRGB(255, 100, 100))
            else
                local codeStr = res and tostring(res.StatusCode) or "Bilinmiyor"
                addMessage("Error", "Beklenmeyen API Hatası: " .. codeStr, Color3.fromRGB(255, 80, 80))
            end

        elseif AISettings.ActiveAI == "OpenAI" then
            oKey = cleanKey(AISettings.OpenAIKey)
            if oKey == "" or string.sub(oKey,1,3) ~= "sk-" then
                addMessage("System", "Girdiğin OpenAI anahtarı 'sk-' ile başlamıyor veya eksik. Doğrulayın.", Color3.fromRGB(255, 100, 100))
                return
            end

            -- OpenAI için messages array oluştur (system + conversation veya sadece son mesaj)
            local messages = {
                {role = "system", content = sysPrompt}
            }
            if IncludeConversation then
                for _, m in ipairs(conversation) do
                    table.insert(messages, {role = m.role, content = m.content})
                end
            else
                table.insert(messages, {role = "user", content = prompt})
            end

            local body = {
                model = "gpt-4o-mini",
                messages = messages
            }

            local res = executeHttpRequestWithRetry({
                Url = "https://api.openai.com/v1/chat/completions",
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. oKey
                },
                Body = HttpService:JSONEncode(body)
            }, 3)

            if res and res.StatusCode == 200 then
                local ok, dat = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok and dat and dat.choices and dat.choices[1] and dat.choices[1].message then
                    local txt = dat.choices[1].message.content or ""
                    table.insert(conversation, {role = "assistant", content = txt})
                    addMessage("Mars AI (OpenAI)", txt, Color3.fromRGB(85, 255, 85))
                else
                    addMessage("Error", "OpenAI'den beklenen formatta yanıt gelmedi.", Color3.fromRGB(255, 80, 80))
                end
            elseif res and res.StatusCode == 429 then
                addMessage("Error", "OpenAI Kota Aşımı (429)! Kredin bitti ya da çok hızlı yazıyorsun.", Color3.fromRGB(255, 100, 100))
            elseif res and res.StatusCode == 401 then
                addMessage("Error", "Yetki Hatası (401): Girdiğin OpenAI Key geçersiz veya silinmiş.", Color3.fromRGB(255, 100, 100))
            else
                local codeStr = res and tostring(res.StatusCode) or "Bilinmiyor"
                addMessage("Error", "OpenAI API Hatası: " .. codeStr, Color3.fromRGB(255, 80, 80))
            end
        end
    end)
end

chatSend.MouseButton1Click:Connect(function()
    if chatInput.Text ~= "" then
        sendToAI(chatInput.Text)
    end
end)

chatInput.FocusLost:Connect(function(enter)
    if enter and chatInput.Text ~= "" then
        sendToAI(chatInput.Text)
    end
end)

-- Ayarlar Buton Olayları
selectAIBtn.MouseButton1Click:Connect(function()
    if AISettings.ActiveAI == "Gemini" then AISettings.ActiveAI = "OpenAI" else AISettings.ActiveAI = "Gemini" end
    selectAIBtn.Text = "Active AI: " .. AISettings.ActiveAI
end)

rgbBtn.MouseButton1Click:Connect(function()
    ThemeSettings.RGBEnabled = not ThemeSettings.RGBEnabled
    rgbBtn.Text = "Rainbow RGB: " .. tostring(ThemeSettings.RGBEnabled)
end)

gradientBtn.MouseButton1Click:Connect(function()
    ThemeSettings.GradientEnabled = not ThemeSettings.GradientEnabled
    gradientBtn.Text = "Gradient Mode: " .. tostring(ThemeSettings.GradientEnabled)
    
    if ThemeSettings.GradientEnabled then
        mainGrad.Enabled = true
        aiGrad.Enabled = true
    else
        mainGrad.Enabled = false
        aiGrad.Enabled = false
        mainStroke.Color = ThemeSettings.CustomColor
        aiGuiStroke.Color = ThemeSettings.CustomColor
    end
end)

saveBtn.MouseButton1Click:Connect(function()
    AISettings.GeminiKey = cleanKey(geminiBox.Text)
    AISettings.OpenAIKey = cleanKey(openaiBox.Text)
    -- otomatik algılama ve kaydet
    detectAndApplyKeysFromText(geminiBox.Text)
    saveSettings()
    saveBtn.Text = "Kaydedildi ve Temizlendi!"
    task.wait(1)
    saveBtn.Text = "Save Configuration & Apply"
end)

aiSettingsBtn.MouseButton1Click:Connect(function()
    chatFrame.Visible = not chatFrame.Visible
    settingsFrame.Visible = not chatFrame.Visible
end)

-- UI Toggle / Min / Max
local aiOpen = false
local minimized = false

aiBtn.MouseButton1Click:Connect(function()
    aiOpen = not aiOpen
    aiGui:TweenPosition(aiOpen and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, 0, 1.5, 0), "Out", "Back", 0.5, true)
end)

aiClose.MouseButton1Click:Connect(function()
    aiOpen = false
    aiGui:TweenPosition(UDim2.new(0.5, 0, 1.5, 0), "Out", "Back", 0.5, true)
end)

aiMin.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        aiGui:TweenSize(UDim2.new(0, 450, 0, 40), "Out", "Quad", 0.3, true)
        chatFrame.Visible = false
        settingsFrame.Visible = false
    else
        aiGui:TweenSize(UDim2.new(0, 450, 0, 350), "Out", "Quad", 0.3, true)
        chatFrame.Visible = true
    end
end)

-- Renk (Theme) Motoru
task.spawn(function()
    local hue = 0
    while RunService.RenderStepped:Wait() do
        if ThemeSettings.RGBEnabled then
            hue = hue + 0.005
            if hue >= 1 then hue = 0 end
            local color1 = Color3.fromHSV(hue, 1, 1)
            local color2 = Color3.fromHSV((hue + 0.5) % 1, 1, 1)
            
            if ThemeSettings.GradientEnabled then
                mainGrad.Color = ColorSequence.new(color1, color2)
                aiGrad.Color = ColorSequence.new(color1, color2)
            else
                mainStroke.Color = color1
                aiGuiStroke.Color = color1
            end
        end
    end
end)

-- Klavye kısayolu M Tuşu
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.M then
        toggleUI()
    end
end)
