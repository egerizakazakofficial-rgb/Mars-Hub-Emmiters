-- Key Temizleme Yardımcısı (Boşlukları kaldırır)
local function cleanKey(key)
    if not key then return "" end
    return (string.gsub(key, "%s+", ""))
end

local function saveSettings()
    if writefile then
        pcall(function()
            local data = HttpService:JSONEncode({
                Theme = {RGB = ThemeSettings.RGBEnabled, Gradient = ThemeSettings.GradientEnabled, R=ThemeSettings.CustomColor.R, G=ThemeSettings.CustomColor.G, B=ThemeSettings.CustomColor.B},
                AI = {
                    ActiveAI = AISettings.ActiveAI,
                    GeminiKey = cleanKey(AISettings.GeminiKey),
                    OpenAIKey = cleanKey(AISettings.OpenAIKey)
                },
                Options = {IncludeConversation = IncludeConversation, TriggerDetect = TriggerDetect}
            })
            writefile("MarsHub_Config.json", data)
        end)
    end
end

local function loadSettings()
    if readfile and isfile and isfile("MarsHub_Config.json") then
        pcall(function()
            local data = HttpService:JSONDecode(readfile("MarsHub_Config.json"))
            if data then
                if data.Theme then
                    ThemeSettings.RGBEnabled = data.Theme.RGB
                    ThemeSettings.GradientEnabled = data.Theme.Gradient
                    ThemeSettings.CustomColor = Color3.new(data.Theme.R, data.Theme.G, data.Theme.B)
                end
                if data.AI then
                    AISettings.ActiveAI = data.AI.ActiveAI or "Gemini"
                    AISettings.GeminiKey = cleanKey(data.AI.GeminiKey or "")
                    AISettings.OpenAIKey = cleanKey(data.AI.OpenAIKey or "")
                end
                if data.Options then
                    IncludeConversation = data.Options.IncludeConversation
                    TriggerDetect = data.Options.TriggerDetect
                end
            end
        end)
    end
end
loadSettings()

