local ThemeSettings = {
    RGBEnabled = false,
    GradientEnabled = false,
    CustomColor = Color3.fromRGB(255, 85, 0)
}
local AISettings = {
    ActiveAI = "Gemini", -- "Gemini" veya "OpenAI"
    GeminiKey = "",
    OpenAIKey = ""
}

-- Kullanıcı isteği: Full/Max ve Trigger algılama seçenekleri
local IncludeConversation = true -- "Max Full" modu: tüm geçmiş gönderilir
local TriggerDetect = true -- Sohbette AQ./sk- anahtarları veya 'max full' tetiklerini algıla

-- Sohbet geçmişi (tüm tur geçmişi saklanır; istenildiği kadar sohbet için büyür)
