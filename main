-- createCategory helper
local function createCategory(name, order)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 40)
    frame.BackgroundTransparency = 1
    frame.LayoutOrder = order
    frame.Parent = scroll

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 30)
    lbl.Text = "  " .. name:upper()
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    lbl.Parent = frame
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)

    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, 0, 0, 0)
    container.Position = UDim2.new(0, 0, 0, 40)
    container.BackgroundTransparency = 1
    container.Parent = frame

    local grid = Instance.new("UIGridLayout", container)
    grid.CellSize = UDim2.new(0, 130, 0, 145)
    grid.CellPadding = UDim2.new(0, 10, 0, 10)
    grid.HorizontalAlignment = Enum.HorizontalAlignment.Center

    grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        container.Size = UDim2.new(1, 0, 0, grid.AbsoluteContentSize.Y)
        frame.Size = UDim2.new(1, -10, 0, grid.AbsoluteContentSize.Y + 50)
    end)

    return container
end

local freeCont = createCategory("Free Emitters", 1)
local premiumCont = createCategory("Emitters (VIP & Premium)", 2)

local cardTable = {}
local activeCards = {}
local multiEnabled = false

local function applyEmitterSafe(id, arg)
    task.spawn(function()
        pcall(function()
            if remote and remote.Parent and remote.InvokeServer then
                remote:InvokeServer(id, arg)
            elseif remote and remote.Parent and remote.FireServer then
                -- fallback if remote is RemoteEvent instead
                remote:FireServer(id, arg)
            end
        end)
    end)
end

-- multi toggle logic
multiBtn.MouseButton1Click:Connect(function()
    multiEnabled = not multiEnabled
    if multiEnabled then
        multiBtn.Text = "Multi: On"
        multiBtn.TextColor3 = Color3.fromRGB(85, 255, 85)
        multiStroke.Color = Color3.fromRGB(85, 255, 85)
    else
        multiBtn.Text = "Multi: Off"
        multiBtn.TextColor3 = Color3.fromRGB(255, 85, 85)
        multiStroke.Color = Color3.fromRGB(40, 40, 45)
        for c, _ in pairs(activeCards) do
            if c and c.Parent and c:FindFirstChild("UIStroke") then
                c.UIStroke.Color = Color3.fromRGB(40, 40, 45)
            end
        end
        table.clear(activeCards)
    end
end)

-- create emitter cards
for _, d in ipairs(emitterData) do
    local card = Instance.new("TextButton")
    card.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    card.Text = ""
    card.Parent = (d[5] or d[6]) and premiumCont or freeCont
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke", card)
    stroke.Color = Color3.fromRGB(40, 40, 45)

    cardTable[card] = d[3]:lower()

    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(0, 60, 0, 60)
    img.Position = UDim2.new(0.5, -30, 0, 15)
    img.Image = "rbxassetid://" .. d[4]
    img.BackgroundTransparency = 1
    img.Parent = card

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -10, 0, 30)
    t.Position = UDim2.new(0, 5, 1, -40)
    t.Text = d[3]
    t.TextColor3 = Color3.fromRGB(200, 200, 200)
    t.Font = Enum.Font.GothamSemibold
    t.TextSize = 10
    t.BackgroundTransparency = 1
    t.Parent = card

    if d[5] then
        local vLogo = Instance.new("ImageLabel")
        vLogo.Size = UDim2.new(0, 26, 0, 26)
        vLogo.Position = UDim2.new(1, -28, 1, -28)
        vLogo.Image = VIP_ICON
        vLogo.BackgroundTransparency = 1
        vLogo.Parent = card
    elseif d[6] then
        local rLogo = Instance.new("ImageLabel")
        rLogo.Size = UDim2.new(0, 26, 0, 26)
        rLogo.Position = UDim2.new(1, -28, 1, -28)
        rLogo.Image = PREMIUM_ICON
        rLogo.BackgroundTransparency = 1
        rLogo.Parent = card
    end

    card.MouseButton1Click:Connect(function()
        if multiEnabled then
            if activeCards[card] then
                activeCards[card] = nil
                stroke.Color = Color3.fromRGB(40, 40, 45)
            else
                local count = 0
                for _ in pairs(activeCards) do count = count + 1 end
                if count < 4 then
                    activeCards[card] = true
                    stroke.Color = Color3.fromRGB(255, 85, 0)
                    applyEmitterSafe(d[1], d[2])
                end
            end
        else
            for c, _ in pairs(activeCards) do
                if c and c.Parent and c:FindFirstChild("UIStroke") then
                    c.UIStroke.Color = Color3.fromRGB(40, 40, 45)
                end
            end
            table.clear(activeCards)

            activeCards[card] = true
            stroke.Color = Color3.fromRGB(255, 85, 0)
            applyEmitterSafe(d[1], d[2])
        end
    end)
end

-- search logic
searchBar:GetPropertyChangedSignal("Text"):Connect(function()
    local text = string.lower(searchBar.Text or "")
    for cardObj, name in pairs(cardTable) do
        if text == "" or string.find(name, text, 1, true) then
            cardObj.Visible = true
        else
            cardObj.Visible = false
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 40)
end)

listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 40)
end)

-- emitter open/close
local emitterOpen = false
local function toggleEmitterUI()
    emitterOpen = not emitterOpen
    if emitterOpen then
        emitterMain:TweenPosition(UDim2.new(0.5, 0, 0.5, 0), "Out", "Back", 0.45, true)
    else
        emitterMain:TweenPosition(UDim2.new(0.5, 0, 1.5, 0), "Out", "Back", 0.45, true)
    end
end

openBtn.MouseButton1Click:Connect(toggleEmitterUI)
emitterClose.MouseButton1Click:Connect(toggleEmitterUI)

-- ===========================
-- AI CHAT UI
-- ===========================
local defaultSettings = {
    apiProvider = "openai", -- default preference if both keys present
    geminiModel = "flash",
    openaiModel = "gpt-4o-mini",
    geminiKey = "",
    openaiKey = "",
    uiBgColor = Color3.fromRGB(10, 10, 12),
    uiAccentColor = Color3.fromRGB(255, 85, 0),
    iconColor = Color3.fromRGB(130, 0, 255),
    aiSize = "max",
}

local settings = {
    apiProvider = defaultSettings.apiProvider,
    geminiModel = defaultSettings.geminiModel,
    openaiModel = defaultSettings.openaiModel,
    geminiKey = defaultSettings.geminiKey,
    openaiKey = defaultSettings.openaiKey,
    uiBgColor = defaultSettings.uiBgColor,
    uiAccentColor = defaultSettings.uiAccentColor,
    iconColor = defaultSettings.iconColor,
    aiSize = defaultSettings.aiSize,
}

-- load from DataStore (best-effort)
local dataStore = nil
pcall(function() dataStore = DataStoreService:GetDataStore("MarsHubAISettings_V1") end)
if dataStore and Players.LocalPlayer then
    local ok, loaded = pcall(function() return dataStore:GetAsync(tostring(Players.LocalPlayer.UserId)) end)
    if ok and type(loaded) == "table" then
        for k,v in pairs(loaded) do settings[k] = v end
    end
end

local function saveSettings()
    if dataStore and Players.LocalPlayer then
        pcall(function() dataStore:SetAsync(tostring(Players.LocalPlayer.UserId), settings) end)
    end
end

-- auto-detect provider based on keys (if only one key present)
local function autoSelectProvider()
    if trim(settings.openaiKey) ~= "" and trim(settings.geminiKey) == "" then
        settings.apiProvider = "openai"
    elseif trim(settings.geminiKey) ~= "" and trim(settings.openaiKey) == "" then
        settings.apiProvider = "gemini"
    end
end
autoSelectProvider()

-- try to detect keys from ReplicatedStorage: MarsHubAIKeys/GeminiKey & OpenAIKey (StringValues)
local function detectKeysFromReplicatedStorage()
    local ok, folder = pcall(function() return ReplicatedStorage:FindFirstChild("MarsHubAIKeys") end)
    if ok and folder and folder:IsA("Folder") then
        local g = folder:FindFirstChild("GeminiKey")
        local o = folder:FindFirstChild("OpenAIKey")
        if g and g:IsA("StringValue") and trim(g.Value) ~= "" then
            settings.geminiKey = trim(g.Value)
        end
        if o and o:IsA("StringValue") and trim(o.Value) ~= "" then
            settings.openaiKey = trim(o.Value)
        end
        autoSelectProvider()
        saveSettings()
    end
end

-- periodically check ReplicatedStorage for keys (useful for executor injection)
task.spawn(function()
    while true do
        pcall(detectKeysFromReplicatedStorage)
        task.wait(8)
    end
end)

