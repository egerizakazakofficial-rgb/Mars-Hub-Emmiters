-- displayMessage returns bubble and resize function
local function displayMessage(text, isUser)
    local msgContainer = Instance.new("Frame")
    msgContainer.Size = UDim2.new(1,0,0,0)
    msgContainer.BackgroundTransparency = 1
    msgContainer.Parent = chatScroll
    msgContainer.ZIndex = 1001

    local bubble = Instance.new("TextLabel")
    bubble.Size = UDim2.new(0.85,0,0,0)
    bubble.Position = isUser and UDim2.new(0.15,0,0,0) or UDim2.new(0,0,0,0)
    bubble.BackgroundColor3 = isUser and settings.uiAccentColor or Color3.fromRGB(35,35,40)
    bubble.TextColor3 = isUser and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
    bubble.TextWrapped = true
    bubble.Font = Enum.Font.Gotham
    bubble.TextSize = 14
    bubble.Text = text or ""
    bubble.Parent = msgContainer
    bubble.ZIndex = 1001

    Instance.new("UICorner", bubble).CornerRadius = UDim.new(0,8)
    Instance.new("UIPadding", bubble).Padding = UDim.new(0,12,0,12)

    local function resize()
        local w = math.max(240, math.floor(aiMain.AbsoluteSize.X * 0.85) - 24)
        local ts = TextService:GetTextSize(bubble.Text, bubble.TextSize, bubble.Font, Vector2.new(w, 2000))
        bubble.Size = UDim2.new(0.85,0,0, math.max(ts.Y + 24, 30))
        msgContainer.Size = UDim2.new(1,0,0,bubble.Size.Y.Offset + 6)
    end

    -- small delay to let layouts compute
    task.spawn(function() task.wait() pcall(resize) end)
    return bubble, msgContainer, resize
end

-- unified request function with timeout
local function requestAI(userMessage, timeoutSeconds, callback)
    timeoutSeconds = timeoutSeconds or 25
    local done = false
    local function finish(ok, text)
        if done then return end
        done = true
        pcall(function() callback(ok, text) end)
    end

    task.spawn(function()
        if settings.apiProvider == "gemini" then
            if settings.geminiKey == "" then
                finish(false, "❌ Gemini API key not set.")
                return
            end
            local model = settings.geminiModel == "flash" and "gemini-2.0-flash-exp" or "gemini-1.5-lite"
            local url = "https://generativelanguage.googleapis.com/v1beta/models/"..model..":generateContent?key="..settings.geminiKey
            local ok, resp = pcall(function()
                local payload = { contents = { { parts = { { text = userMessage } } } } }
                return HttpService:PostAsync(url, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
            end)
            if not ok or not resp then finish(false, "❌ Gemini request failed.") return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(resp) end)
            if not ok2 or not data then finish(false, "❌ Gemini invalid response.") return end
            if data and data.candidates and data.candidates[1] and data.candidates[1].content and data.candidates[1].content.parts and data.candidates[1].content.parts[1] then
                finish(true, data.candidates[1].content.parts[1].text)
            else finish(false, "❌ Gemini returned nothing.") end
        else
            if settings.openaiKey == "" then finish(false, "❌ OpenAI API key not set.") return end
            local url = "https://api.openai.com/v1/chat/completions"
            local ok, respBody = pcall(function()
                local payload = { model = settings.openaiModel, messages = { { role = "user", content = userMessage } }, max_tokens = 2000 }
                if HttpService.RequestAsync then
                    local r = HttpService:RequestAsync({ Url = url, Method = "POST", Headers = { ["Content-Type"]="application/json", ["Authorization"]="Bearer "..settings.openaiKey }, Body = HttpService:JSONEncode(payload) })
                    return r and r.Body or nil
                else
                    return HttpService:PostAsync(url, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
                end
            end)
            if not ok or not respBody then finish(false, "❌ OpenAI request failed.") return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(respBody) end)
            if not ok2 or not data then finish(false, "❌ OpenAI invalid response.") return end
            if data and data.choices and data.choices[1] and data.choices[1].message and data.choices[1].message.content then
                finish(true, data.choices[1].message.content)
            else finish(false, "❌ OpenAI returned nothing.") end
        end
    end)

    task.delay(timeoutSeconds, function()
        if not done then
            done = true
            pcall(function() callback(false, "❌ Request timed out after "..tostring(timeoutSeconds).."s.") end)
        end
    end)
end

