sendBtn.Size = UDim2.new(0,80,0,48)
sendBtn.Position = UDim2.new(1,-96,0,11)
sendBtn.Text = "Send"
sendBtn.Font = Enum.Font.GothamBold
sendBtn.TextSize = 16
sendBtn.BackgroundColor3 = settings.uiAccentColor
sendBtn.Parent = aiInputFrame
Instance.new("UICorner", sendBtn).CornerRadius = UDim.new(0,6)
sendBtn.ZIndex = 1002

local function sendMessage()
    local msg = trim(inputBox.Text)
    if msg == "" then return end

    displayMessage(msg, true)

    local typingBubble, typingContainer, resizeFn = displayMessage("⏳ Thinking...", false)

    inputBox.Text = ""
    inputBox.Active = false
    sendBtn.Active = false
    sendBtn.AutoButtonColor = false
    sendBtn.BackgroundTransparency = 0.5

    local anim = true
    task.spawn(function()
        local dots = 0
        while anim and typingBubble and typingBubble.Parent do
            dots = (dots % 3) + 1
            typingBubble.Text = "⏳ Thinking" .. string.rep(".", dots)
            if resizeFn then pcall(resizeFn) end
            task.wait(0.5)
        end
    end)

    requestAI(msg, 25, function(success, text)
        anim = false
        if typingBubble and typingBubble.Parent then
            typingBubble.Text = text or (success and "" or "❌ Error")
            typingBubble.TextColor3 = Color3.fromRGB(255,255,255)
            typingBubble.BackgroundColor3 = Color3.fromRGB(35,35,40)
            if resizeFn then pcall(resizeFn) end
        else
            displayMessage(text or "❌ Error", false)
        end

        inputBox.Active = true
        sendBtn.Active = true
        sendBtn.AutoButtonColor = true
        sendBtn.BackgroundTransparency = 0
    end)
end

sendBtn.MouseButton1Click:Connect(sendMessage)
inputBox.FocusLost:Connect(function(enterPressed) if enterPressed then sendMessage() end end)

