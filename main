local function displayMessageBubble(text, isUser)
    local container = Instance.new("Frame"); container.BackgroundTransparency = 1; container.Size = UDim2.new(1,0,0,0); container.Parent = chatScroll
    local bubble = Instance.new("TextLabel"); bubble.Parent = container
    bubble.Size = UDim2.new(0.85,0,0,0)
    bubble.Position = isUser and UDim2.new(0.15,0,0,0) or UDim2.new(0,0,0,0)
    bubble.BackgroundColor3 = isUser and AISettings.uiAccentColor or Color3.fromRGB(35,35,40)
    bubble.TextColor3 = isUser and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
    bubble.TextWrapped = true
    bubble.Font = Enum.Font.Gotham
    bubble.TextSize = 14
    bubble.Text = text or ""
    Instance.new("UICorner", bubble).CornerRadius = UDim.new(0,8)
    Instance.new("UIPadding", bubble).Padding = UDim.new(0,12,0,12)
    -- resize utility
    local function resize()
        local w = math.max(240, math.floor(aiMain.AbsoluteSize.X * 0.85) - 24)
        local ts = TextService:GetTextSize(bubble.Text, bubble.TextSize, bubble.Font, Vector2.new(w,2000))
        bubble.Size = UDim2.new(0.85,0,0, math.max(ts.Y + 24, 30))
        container.Size = UDim2.new(1,0,0,bubble.Size.Y.Offset + 6)
    end
    task.spawn(function() task.wait(); pcall(resize) end)
    return bubble, container, resize
end

-- unified request function (OpenAI / Gemini) with 25s timeout
local function requestAI(message, timeout, cb)
    timeout = timeout or 25
    local done = false
    local function finish(ok, res) if done then return end done = true pcall(function() cb(ok, res) end) end

    -- choose provider automatically if only one key present
    if trim(AISettings.openaiKey) ~= "" and trim(AISettings.geminiKey) == "" then AISettings.apiProvider = "openai" end
    if trim(AISettings.geminiKey) ~= "" and trim(AISettings.openaiKey) == "" then AISettings.apiProvider = "gemini" end

    task.spawn(function()
        if AISettings.apiProvider == "gemini" then
            if trim(AISettings.geminiKey) == "" then finish(false, "❌ Gemini key not set"); return end
            local model = AISettings.geminiModel == "flash" and "gemini-2.0-flash-exp" or "gemini-1.5-lite"
            local url = "https://generativelanguage.googleapis.com/v1beta/models/"..model..":generateContent?key="..AISettings.geminiKey
            local ok, resp = pcall(function()
                local payload = { contents = { { parts = { { text = message } } } } }
                return HttpService:PostAsync(url, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
            end)
            if not ok or not resp then finish(false, "❌ Gemini request failed"); return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(resp) end)
            if not ok2 or not data then finish(false, "❌ Gemini invalid response"); return end
            if data and data.candidates and data.candidates[1] and data.candidates[1].content and data.candidates[1].content.parts and data.candidates[1].content.parts[1] then
                finish(true, data.candidates[1].content.parts[1].text)
            else finish(false, "❌ Gemini returned nothing") end
        else
            if trim(AISettings.openaiKey) == "" then finish(false, "❌ OpenAI key not set"); return end
            local url = "https://api.openai.com/v1/chat/completions"
            local ok, respBody = pcall(function()
                local payload = { model = AISettings.openaiModel, messages = { { role = "user", content = message } }, max_tokens = 2000 }
                if HttpService.RequestAsync then
                    local r = HttpService:RequestAsync({ Url = url, Method = "POST", Headers = { ["Content-Type"]="application/json", ["Authorization"]="Bearer "..AISettings.openaiKey }, Body = HttpService:JSONEncode(payload) })
                    return r and r.Body or nil
                else
                    return HttpService:PostAsync(url, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
                end
            end)
            if not ok or not respBody then finish(false, "❌ OpenAI request failed"); return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(respBody) end)
            if not ok2 or not data then finish(false, "❌ OpenAI invalid response"); return end
            if data and data.choices and data.choices[1] and data.choices[1].message and data.choices[1].message.content then
                finish(true, data.choices[1].message.content)
            else finish(false, "❌ OpenAI returned nothing") end
        end
    end)

    task.delay(timeout, function()
        if not done then done = true pcall(function() cb(false, "❌ Request timed out after "..tostring(timeout).."s.") end) end
    end)
end

-- AI input area
local aiInputFrame = Instance.new("Frame"); aiInputFrame.Size = UDim2.new(1,0,0,70); aiInputFrame.Position = UDim2.new(0,0,1,-70); aiInputFrame.BackgroundColor3 = Color3.fromRGB(18,18,20); aiInputFrame.Parent = aiMain
local inputBox = Instance.new("TextBox"); inputBox.Size = UDim2.new(1, -120, 0, 48); inputBox.Position = UDim2.new(0,16,0,11); inputBox.BackgroundColor3 = Color3.fromRGB(28,28,30); inputBox.TextColor3 = Color3.fromRGB(255,255,255); inputBox.PlaceholderText = "Ask me anything..."; inputBox.Font = Enum.Font.Gotham; inputBox.TextSize = 16; inputBox.Parent = aiInputFrame; Instance.new("UICorner", inputBox).CornerRadius = UDim.new(0,6)
local sendBtn = Instance.new("TextButton"); sendBtn.Size = UDim2.new(0,80,0,48); sendBtn.Position = UDim2.new(1,-96,0,11); sendBtn.Text = "Send"; sendBtn.Font = Enum.Font.GothamBold; sendBtn.TextSize = 16; sendBtn.BackgroundColor3 = AISettings.uiAccentColor; sendBtn.Parent = aiInputFrame; Instance.new("UICorner", sendBtn).CornerRadius = UDim.new(0,6)

local function sendMessage()
    local msg = trim(inputBox.Text)
    if msg == "" then return end
    displayMessageBubble(msg, true)
    local typingBubble, typingContainer, resizeFn = displayMessageBubble("⏳ Thinking...", false)
    inputBox.Text = ""
    inputBox.Active = false; sendBtn.Active = false; sendBtn.AutoButtonColor = false; sendBtn.BackgroundTransparency = 0.5
    local anim = true
    task.spawn(function()
        local dots = 0
        while anim and typingBubble and typingBubble.Parent do
            dots = (dots % 3) + 1
            typingBubble.Text = "⏳ Thinking" .. string.rep(".", dots)
            if resizeFn then pcall(resizeFn) end
            task.wait(0.5)
        end
    end)
    requestAI(msg, 25, function(success, text)
        anim = false
        if typingBubble and typingBubble.Parent then
            typingBubble.Text = text or (success and "" or "❌ Error")
            typingBubble.TextColor3 = Color3.fromRGB(255,255,255)
            typingBubble.BackgroundColor3 = Color3.fromRGB(35,35,40)
            if resizeFn then pcall(resizeFn) end
        else
            displayMessageBubble(text or "❌ Error", false)
        end
        inputBox.Active = true; sendBtn.Active = true; sendBtn.AutoButtonColor = true; sendBtn.BackgroundTransparency = 0
    end)
end

sendBtn.MouseButton1Click:Connect(sendMessage)
inputBox.FocusLost:Connect(function(enterPressed) if enterPressed then sendMessage() end end)

