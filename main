-- Safe trim
local function trim(s) if not s then return "" end return s:match("^%s*(.-)%s*$") or "" end

-- Cleanup old GUI if present
if CoreGui:FindFirstChild("ProjectGames_System") then
    CoreGui.ProjectGames_System:Destroy()
end

-- Remote (emitters) safe-get
local remote = nil
pcall(function()
    local remFolder = ReplicatedStorage:FindFirstChild("Remotes")
    if remFolder then
        remote = remFolder:FindFirstChild("ApplyEmmiter")
    end
end)

-- ScreenGui root
