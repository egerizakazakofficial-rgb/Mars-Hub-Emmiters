local COLORS = {
    bg = Color3.fromRGB(13, 13, 17),
    panel = Color3.fromRGB(19, 19, 24),
    card = Color3.fromRGB(25, 25, 31),
    stroke = Color3.fromRGB(145, 0, 255),
    accent = Color3.fromRGB(160, 70, 255),
    text = Color3.fromRGB(245, 245, 250),
    sub = Color3.fromRGB(175, 175, 190),
    danger = Color3.fromRGB(230, 70, 80),
    success = Color3.fromRGB(50, 200, 120),
}

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = obj
    return c
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or COLORS.stroke
    s.Thickness = thickness or 1.5
    s.Transparency = 0.15
    s.Parent = obj
    return s
end

local function newButton(parent, text, size, pos)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos or UDim2.fromOffset(0, 0)
    b.BackgroundColor3 = COLORS.card
    b.TextColor3 = COLORS.text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.Text = text
    b.AutoButtonColor = false
    b.Parent = parent
    corner(b, 8)
    stroke(b, Color3.fromRGB(55, 55, 65), 1)
    b.Activated:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = COLORS.accent}):Play()
        task.delay(0.12, function()
            if b.Parent then
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = COLORS.card}):Play()
            end
        end)
    end)
    return b
end

local function makeDraggable(handle, object)
    local dragging = false
    local dragStart
    local startPos
    local dragInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

