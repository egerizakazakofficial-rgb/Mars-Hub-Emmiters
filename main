local function showOnly(frame)
    adminFrame.Visible = frame == adminFrame
    toolsFrame.Visible = frame == toolsFrame
    aiFrame.Visible = frame == aiFrame
    local target = frame and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, 0, 1.5, 0)
    if frame == adminFrame then
        toolsFrame.Position = target
        aiFrame.Position = target
    end
    frame.Position = target
end

local adminOpen = false
local toolsOpen = false
local aiOpen = false

local function openFrame(frame)
    adminOpen = frame == adminFrame and not adminOpen
    toolsOpen = frame == toolsFrame and not toolsOpen
    aiOpen = frame == aiFrame and not aiOpen

    if not adminOpen and not toolsOpen and not aiOpen then
        for _, f in ipairs({adminFrame, toolsFrame, aiFrame}) do
            f.Visible = false
            f.Position = UDim2.new(0.5,0,1.5,0)
        end
        return
    end

    for _, f in ipairs({adminFrame, toolsFrame, aiFrame}) do
        f.Visible = (f == frame)
        if f == frame then
            f.Position = UDim2.new(0.5,0,1.5,0)
            f:TweenPosition(UDim2.new(0.5,0,0.5,0), "Out", "Quint", 0.35, true)
        end
    end
end

openAdmin.Activated:Connect(function() openFrame(adminFrame) end)
openTools.Activated:Connect(function() openFrame(toolsFrame) end)
openAI.Activated:Connect(function() openFrame(aiFrame) end)
closeAdmin.Activated:Connect(function() openFrame(adminFrame) end)
closeTools.Activated:Connect(function() openFrame(toolsFrame) end)
aiClose.Activated:Connect(function() openFrame(aiFrame) end)

makeDraggable(header, adminFrame)
makeDraggable(toolHeader, toolsFrame)
makeDraggable(aiHeader, aiFrame)

-- Mobile/PC keyboard shortcut: RightShift toggles Admin
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        openFrame(adminFrame)
    end
end)

print("EgeOwnerAdminHub loaded | OWNER_ID = " .. tostring(OWNER_ID))

--[[
======================== SERVER SCRIPT ========================
Put this part in ServerScriptService as a normal Script.
This is the REAL security boundary; the client-side ID check only hides the UI.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local OWNER_ID = 4562707344
local remote = ReplicatedStorage:FindFirstChild("AdminAction") or Instance.new("RemoteEvent")
remote.Name = "AdminAction"
remote.Parent = ReplicatedStorage

local function findPlayer(name)
    if type(name) ~= "string" or name == "" then return nil end
    name = string.lower(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == name or string.lower(p.DisplayName) == name then
            return p
        end
    end
end

remote.OnServerEvent:Connect(function(sender, action, payload)
    if sender.UserId ~= OWNER_ID then
        return
    end

    payload = type(payload) == "table" and payload or {}
    local target = findPlayer(payload.target)

    if action == "Announce" then
        -- Add your server-side announcement system here.
    elseif action == "Kick" and target then
        target:Kick(tostring(payload.reason or "Removed by owner."))
    elseif action == "Respawn" and target then
        target:LoadCharacter()
    elseif action == "Freeze" and target and target.Character then
        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 0 end
    elseif action == "Unfreeze" and target and target.Character then
        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    elseif action == "Bring" and target and target.Character and sender.Character then
        local src = sender.Character:FindFirstChild("HumanoidRootPart")
        local dst = target.Character:FindFirstChild("HumanoidRootPart")
        if src and dst then dst.CFrame = src.CFrame * CFrame.new(0, 0, -4) end
    elseif action == "Heal" and target and target.Character then
        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = hum.MaxHealth end
    elseif action == "GiveTool" then
        -- Implement your own server-authorized tool whitelist here.
        -- Do not trust arbitrary client-provided instances/paths.
    elseif action == "AICommand" then
        -- Route this to a server/backend endpoint you control.
    elseif action == "Refresh" then
        -- Add any server-side refresh operation you need.
    end
end)
]]
