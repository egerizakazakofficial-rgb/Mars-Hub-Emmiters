-- trim helper
local function trim(s)
    if not s then return "" end
    return s:match("^%s*(.-)%s*$") or s
end

-- sendMessage now creates a typing bubble and updates it when result arrives
local function sendMessage()
    local msg = trim(inputBox.Text)
    if msg == "" then return end

    -- display user's message
    displayMessage(msg, true)

    -- create assistant typing bubble
    local typingBubble, typingContainer, resizeFn = displayMessage("⏳ Thinking...", false)

    -- disable input while waiting
    inputBox.ClearTextOnFocus = false
    inputBox.Active = false
    sendBtn.Active = false
    sendBtn.AutoButtonColor = false
    sendBtn.BackgroundTransparency = 0.5

    inputBox.Text = ""

    -- typing dots animation
    local animRunning = true
    task.spawn(function()
        local dots = 0
        while animRunning and typingBubble and typingBubble.Parent do
            dots = (dots % 3) + 1
            typingBubble.Text = "⏳ Thinking" .. string.rep(".", dots)
            if resizeFn then pcall(resizeFn) end
            task.wait(0.5)
        end
    end)

    -- perform request
    requestAI(msg, 25, function(success, text)
        -- stop animation
        animRunning = false

        if not typingBubble or not typingBubble.Parent then
            -- fallback: just display result as new message
            if success then
                displayMessage(text, false)
            else
                displayMessage(text, false)
            end
        else
            -- update the existing typing bubble with final text
            typingBubble.Text = text or (success and "" or "❌ Error")
            -- update colors if needed
            typingBubble.TextColor3 = Color3.fromRGB(255, 255, 255)
            typingBubble.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            if resizeFn then pcall(resizeFn) end
        end

        -- re-enable input
        inputBox.Active = true
        sendBtn.Active = true
        sendBtn.AutoButtonColor = true
        sendBtn.BackgroundTransparency = 0
    end)
end

sendBtn.MouseButton1Click:Connect(sendMessage)

inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        sendMessage()
    end
end)

