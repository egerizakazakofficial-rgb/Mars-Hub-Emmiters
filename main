-- Toggle AI UI (connected to header btn and quick btn)
local aiOpen = false
local function toggleAI()
    aiOpen = not aiOpen
    if aiOpen then
        detectKeysFromReplicatedStorage()
        aiMain.Visible = true
        aiMain:TweenPosition(UDim2.new(0.5,0,0.5,0), "Out", "Back", 0.35, true)
    else
        aiMain:TweenPosition(UDim2.new(0.5,0,1.5,0), "Out", "Back", 0.35, true)
        task.delay(0.36, function() if aiMain and aiMain.Parent then aiMain.Visible = false end end)
    end
end

quickAiBtn.MouseButton1Click:Connect(toggleAI)
aiHeaderBtn.MouseButton1Click:Connect(toggleAI)
aiSettingsBtn.MouseButton1Click:Connect(function() settingsPanel.Visible = not settingsPanel.Visible end)
aiCloseBtn.MouseButton1Click:Connect(toggleAI)
aiSizeBtn.MouseButton1Click:Connect(function()
    local cur = AISettings.aiSize or "max"
    if cur == "small" then AISettings.aiSize = "normal"; setAISize("normal")
    elseif cur == "normal" then AISettings.aiSize = "max"; setAISize("max")
    else AISettings.aiSize = "small"; setAISize("small") end
    saveAISettings()
end)

-- Keep scrolls sized initially
task.defer(function()
    pcall(function()
        scroll.CanvasSize = UDim2.new(0,0,0,listLayout.AbsoluteContentSize.Y + 40)
        chatScroll.CanvasSize = UDim2.new(0,0,0,chatLayout.AbsoluteContentSize.Y + 20)
    end)
end)

