createSettingLabel("📋 ACTIONS", 15)
local saveBtn = Instance.new("TextButton")
saveBtn.Size = UDim2.new(1, -20, 0, 40)
saveBtn.Position = UDim2.new(0, 10, 0, 0)
saveBtn.Text = "💾 Save Settings"
saveBtn.TextColor3 = Color3.fromRGB(255,255,255)
saveBtn.Font = Enum.Font.GothamBold
saveBtn.TextSize = 11
saveBtn.BackgroundColor3 = Color3.fromRGB(85, 255, 85)
saveBtn.LayoutOrder = 16
saveBtn.Parent = settingsScroll
Instance.new("UICorner", saveBtn).CornerRadius = UDim.new(0, 8)

saveBtn.MouseButton1Click:Connect(function()
    saveSettings()
    displayMessage("✅ Settings saved successfully!", false)
end)

local resetBtn = Instance.new("TextButton")
resetBtn.Size = UDim2.new(1, -20, 0, 40)
resetBtn.Position = UDim2.new(0, 10, 0, 0)
resetBtn.Text = "🔄 Reset to Default"
resetBtn.TextColor3 = Color3.fromRGB(255,255,255)
resetBtn.Font = Enum.Font.GothamBold
resetBtn.TextSize = 11
resetBtn.BackgroundColor3 = Color3.fromRGB(255, 85, 85)
resetBtn.LayoutOrder = 17
resetBtn.Parent = settingsScroll
Instance.new("UICorner", resetBtn).CornerRadius = UDim.new(0, 8)

resetBtn.MouseButton1Click:Connect(function()
    settings = {
        apiProvider = defaultSettings.apiProvider,
        geminiModel = defaultSettings.geminiModel,
        openaiModel = defaultSettings.openaiModel,
        geminiKey = defaultSettings.geminiKey,
        openaiKey = defaultSettings.openaiKey,
        uiBgColor = defaultSettings.uiBgColor,
        uiAccentColor = defaultSettings.uiAccentColor,
        iconColor = defaultSettings.iconColor,
        aiSize = defaultSettings.aiSize,
    }
    saveSettings()
    setAISize(settings.aiSize)
    aiMain.BackgroundColor3 = settings.uiBgColor
    aiMainStroke.Color = settings.uiAccentColor
    settingsStroke.Color = settings.uiAccentColor
    sendBtn.BackgroundColor3 = settings.uiAccentColor
    displayMessage("🔄 Settings reset to default!", false)
end)

-- Settings panel toggles
aiSettingsBtn.MouseButton1Click:Connect(function()
    settingsPanel.Visible = not settingsPanel.Visible
end)
settingsClose.MouseButton1Click:Connect(function()
    settingsPanel.Visible = false
end)

-- AI panel toggle (aiBtn placed in emitter header) - robust open/close with ZIndex handling
local aiOpen = false
local function toggleAIUI()
    aiOpen = not aiOpen
    if aiOpen then
        -- ensure AI above other UI
        aiMain.ZIndex = 100
        aiTop.ZIndex = 101
        chatScroll.ZIndex = 101
        aiInputFrame.ZIndex = 101
        settingsPanel.ZIndex = 200

        aiMain.Visible = true
        aiMain:TweenPosition(UDim2.new(0.5, 0, 0.5, 0), "Out", "Back", 0.45, true)
    else
        aiMain:TweenPosition(UDim2.new(0.5, 0, 1.5, 0), "Out", "Back", 0.45, true)
        task.delay(0.5, function()
            if aiMain and aiMain.Parent then
                aiMain.Visible = false
            end
        end)
    end
end

aiBtn.MouseButton1Click:Connect(toggleAIUI)
aiClose.MouseButton1Click:Connect(toggleAIUI)

-- size quick-cycle button
aiSizeBtn.MouseButton1Click:Connect(function()
    local current = settings.aiSize or "normal"
    if current == "small" then
        setAISize("normal")
    elseif current == "normal" then
        setAISize("max")
    else
        setAISize("small")
    end
    saveSettings()
end)

-- auto-scroll for chat
chatLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    chatScroll.CanvasSize = UDim2.new(0, 0, 0, chatLayout.AbsoluteContentSize.Y + 20)
    chatScroll.CanvasPosition = Vector2.new(0, chatLayout.AbsoluteContentSize.Y)
end)

-- welcome
displayMessage("👋 Welcome to Mars Hub AI Chat! Open Settings to set your API keys.", false)

-- Ensure emitter and AI canvases are sized correctly initially
task.defer(function()
    scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 40)
    chatScroll.CanvasSize = UDim2.new(0, 0, 0, chatLayout.AbsoluteContentSize.Y + 20)
end)

-- End of merged script
