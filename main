local function sendAdmin(action, payload)
    if not ADMIN_REMOTE then
        status.Text = "AdminAction RemoteEvent bulunamadı. Server scriptini ekle."
        status.TextColor3 = COLORS.danger
        return
    end
    if ADMIN_REMOTE:IsA("RemoteEvent") then
        ADMIN_REMOTE:FireServer(action, payload)
        status.Text = "İstek gönderildi: " .. action
        status.TextColor3 = COLORS.success
    else
        status.Text = "AdminAction bir RemoteEvent olmalı."
        status.TextColor3 = COLORS.danger
    end
end

