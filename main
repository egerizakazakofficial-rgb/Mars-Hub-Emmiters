-- Kategori Oluşturucu
local function createCategory(name, order)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 40)
    frame.BackgroundTransparency = 1
    frame.LayoutOrder = order
    frame.Parent = scroll
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 30)
    lbl.Text = "  " .. name:upper()
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    lbl.Parent = frame
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)
    
    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, 0, 0, 0)
    container.Position = UDim2.new(0, 0, 0, 40)
    container.BackgroundTransparency = 1
    container.Parent = frame
    
    local grid = Instance.new("UIGridLayout", container)
    grid.CellSize = UDim2.new(0, 130, 0, 145)
    grid.CellPadding = UDim2.new(0, 10, 0, 10)
    grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
    
    grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        container.Size = UDim2.new(1, 0, 0, grid.AbsoluteContentSize.Y)
        frame.Size = UDim2.new(1, -10, 0, grid.AbsoluteContentSize.Y + 50)
    end)
    
    return container
end

local freeCont = createCategory("Free Emitters", 1)
local premiumCont = createCategory("Emitters (VIP & Premium)", 2)

-- Veritabanı
local cardTable = {}
local activeCards = {}
local multiEnabled = false
local MAX_MULTI_SELECT = 4 -- istenirse buradan değiştirilebilir

-- Güvenli Emitter Uygulama (Asenkron ve Çökme Korumalı)
local function applyEmitterSafe(id, arg)
    task.spawn(function()
        local ok, err = pcall(function()
            if remote and remote.Parent then
                -- remote:InvokeServer şeklinde doğrudan çağrı pcall içinde
                remote:InvokeServer(id, arg)
            end
        end)
        -- hata varsa istersen buraya log ekleyebilirsin (şimdilik sessiz)
    end)
end

-- Multi-Select Toggle
multiBtn.MouseButton1Click:Connect(function()
    multiEnabled = not multiEnabled
    if multiEnabled then
        multiBtn.Text = "Multi"
        multiBtn.TextColor3 = Color3.fromRGB(85, 255, 85)
        multiStroke.Color = Color3.fromRGB(85, 255, 85)
    else
        multiBtn.Text = "Offline"
        multiBtn.TextColor3 = Color3.fromRGB(255, 85, 85)
        multiStroke.Color = Color3.fromRGB(40, 40, 45)
        
        for c, _ in pairs(activeCards) do
            if c and c.Parent and c:FindFirstChild("UIStroke") then
                c.UIStroke.Color = Color3.fromRGB(40, 40, 45)
            end
        end
        table.clear(activeCards)
    end
end)

-- Kartları Oluştur
for _, d in ipairs(emitterData) do
    local card = Instance.new("TextButton")
    card.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    card.Text = ""
    card.Parent = (d[5] or d[6]) and premiumCont or freeCont
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
    
    local stroke = Instance.new("UIStroke", card)
    stroke.Color = Color3.fromRGB(40, 40, 45)

    cardTable[card] = d[3]:lower()

    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(0, 60, 0, 60)
    img.Position = UDim2.new(0.5, -30, 0, 15)
    img.Image = "rbxassetid://" .. d[4]
    img.BackgroundTransparency = 1
    img.Parent = card

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -10, 0, 30)
    t.Position = UDim2.new(0, 5, 1, -40)
    t.Text = d[3]
    t.TextColor3 = Color3.fromRGB(200, 200, 200)
    t.Font = Enum.Font.GothamSemibold
    t.TextSize = 10
    t.BackgroundTransparency = 1
    t.Parent = card

    if d[5] then
        local vLogo = Instance.new("ImageLabel")
        vLogo.Size = UDim2.new(0, 26, 0, 26)
        vLogo.Position = UDim2.new(1, -28, 1, -28)
        vLogo.Image = VIP_ICON
        vLogo.BackgroundTransparency = 1
        vLogo.Parent = card
    elseif d[6] then
        local rLogo = Instance.new("ImageLabel")
        rLogo.Size = UDim2.new(0, 26, 0, 26)
        rLogo.Position = UDim2.new(1, -28, 1, -28)
        rLogo.Image = PREMIUM_ICON
        rLogo.BackgroundTransparency = 1
        rLogo.Parent = card
    end

    -- Tooltip gösterimi
    card.MouseEnter:Connect(function()
        tooltip.Text = d[3]
        local mousePos = UserInputService:GetMouseLocation()
        -- küçük offset ile mouse'un sağ-altında göster
        tooltip.Position = UDim2.new(0, mousePos.X + 10, 0, mousePos.Y + 10)
        tooltip.Visible = true
    end)
    card.MouseLeave:Connect(function()
        tooltip.Visible = false
    end)

    card.MouseButton1Click:Connect(function()
        if multiEnabled then
            if activeCards[card] then
                activeCards[card] = nil
                stroke.Color = Color3.fromRGB(40, 40, 45)
            else
                local count = 0
                for _ in pairs(activeCards) do count = count + 1 end
                if count < MAX_MULTI_SELECT then
                    activeCards[card] = true
                    stroke.Color = Color3.fromRGB(255, 85, 0)
                    applyEmitterSafe(d[1], d[2])
                end
            end
        else
            for c, _ in pairs(activeCards) do
                if c and c.Parent and c:FindFirstChild("UIStroke") then
                    c.UIStroke.Color = Color3.fromRGB(40, 40, 45)
                end
            end
            table.clear(activeCards)
            
            activeCards[card] = true
            stroke.Color = Color3.fromRGB(255, 85, 0)
            applyEmitterSafe(d[1], d[2])
        end
    end)
end

-- Arama Çubuğu (Geliştirilmiş)
searchBar:GetPropertyChangedSignal("Text"):Connect(function()
    local text = searchBar.Text:lower()
    for cardObj, name in pairs(cardTable) do
        if text == "" or string.find(name, text, 1, true) then
            cardObj.Visible = true
        else
            cardObj.Visible = false
        end
    end
    -- Arama sonrası Scroll boyutunu tazelemek için tetikleyici
    scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 40)
end)

-- Tween & Toggle
local open = false
local function toggleUI()
    open = not open
    main:TweenPosition(open and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, 0, 1.5, 0), "Out", "Back", 0.5, true)
end

openBtn.MouseButton1Click:Connect(toggleUI)
close.MouseButton1Click:Connect(toggleUI)

-- Klavye kısayolu: M ile toggle (oyun işlenmiş input'larını bozmaz)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.M then
        toggleUI()
    end
end)

-- Scroll Canvas Dinamik Güncelleme
listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 40)
end)
